# 1. 의존성 (Dependencies)
# 용량이 매우 크고, package.json / package-lock.json을 통해 재설치 가능하므로 제외
node_modules/
.pnpm-store/

# 2. 빌드 및 번들링 결과물 (Production / Build Outputs)
# 소스 코드가 아니므로 제외 (Vite 기본 출력 폴더는 dist)
dist/
dist-ssr/
build/
*.local

# 3. 개발 도구 및 캐시 파일 (Logs & Caches)
# 개발 및 번들링 과정에서 생기는 임시 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
.vite/

# 4. 환경 변수 및 비밀 키 (Environment Variables & Secrets)
# API 키나 DB 비밀번호 등이 유출되는 것을 방지 (보안 필수)
.env
.env.local
.env.*.local

# 5. IDE 및 에디터 설정 (Editor Directories)
# 개발자 개인의 에디터 설정이 Git에 얽히는 것을 방지
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. OS 생성 임시 파일 (System Files)
# macOS 및 Windows 시스템 파일
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db